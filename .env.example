# Copy to .env and replace with your own values if you fork this repo.
# These are throwaway credentials for the standalone reproduction.

PUBLIC_JAZZ_APP_ID=4568a15b-e9b1-500b-a047-2b57358cebce
PUBLIC_JAZZ_SERVER_URL=https://v2.sync.jazz.tools/

# JAZZ_ADMIN_SECRET is consumed only by the Vite plugin (dev) to push
# schema.ts + permissions.ts to the sync server. Not bundled to the
# client. Generate a new one with `node -e "console.log(require('crypto').randomBytes(24).toString('base64').replace(/[+/=]/g,'').slice(0,32))"`.
JAZZ_ADMIN_SECRET=cnReu8wIS7RQud93puIFwCJz82JVn
